{
  "$schema": "https://json.schemastore.org/nest-cli",
  "monorepo": true,
  "collection": "@nestjs/schematics",
  "root": "./apps/nestjs-app",
  "projects": {
    "nestjs-app": {
      "type": "application",
      "root": "apps/nestjs-app",
      "entryFile": "main",
      "sourceRoot": "apps/nestjs-app/src",
      "compilerOptions": {
        "tsConfigPath": "apps/nestjs-app/tsconfig.build.json"
      }
    }
  }
}
